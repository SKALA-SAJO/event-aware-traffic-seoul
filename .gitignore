# 런타임 산출물
data/traffic.db
data/traffic_synthetic.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/synthetic/
# 원천 데이터: TOPIS 엑셀·CSV 는 대용량이라 제외(scripts/bootstrap_data.sh 로 재구성),
# 이벤트 입력(집회·A매치·통제 공지, 약 2.5MB)과 출처 문서는 재현을 위해 커밋
data/raw/*
!data/raw/events/
# KOPIS 공연시설 캐시(공개 정보, 136KB): 없으면 매번 거점 구 공연시설 약 880곳을 다시 조회해 5분 걸림
# (GitHub Actions collect_events). hubs.yaml 의 kopis_districts 를 바꾸면 hub_venues(refresh=True) 로 갱신
!data/raw/kopis_venues.json
data/uploads/*
!data/uploads/.gitkeep
data/sample_haic_prices.csv
mlflow.db
mlflow_synthetic.db
mlruns/
logs/*.log
serving_app/models/*.keras
serving_app/models/*.pkl
serving_app/models/preprocess.json

# 실시간 수집 산출물: GitHub Actions 는 data-collect 브랜치에 쌓으므로, 로컬에서
# scripts/collect_snapshot.py · collect_events.py 를 돌려 생긴 collected/ 는 커밋하지 않음
collected/

# API 키 (커밋·이미지에 포함 금지). 키 이름만 적은 예시 파일은 허용
.env
.env.*
!.env.example

# 파생 데이터 (LLM 구조화 결과 등, 스크립트로 재생성)
data/derived/

# 임시 학습 DB·로그
mlflow_dev.db
logs/
